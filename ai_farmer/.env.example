# AI Farmer v3.0 Environment Configuration

# AI provider: auto detects configured hosted keys; or select openai, groq, gemini,
# anthropic, openrouter, ollama, or custom.
AI_PROVIDER=auto
# Optional model override. Defaults vary by provider.
AI_MODEL=
# Optional key override for the selected provider.
AI_API_KEY=
# For custom OpenAI-compatible servers, set the full API root (ending in /v1).
# For Ollama, set AI_PROVIDER=ollama and optionally OLLAMA_BASE_URL.
AI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenRouter (hosted and open-weight models)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your-weather-api-key-here

# Market Price API (Agmarknet)
MARKET_API_KEY=your-agmarknet-key-here

# JWT Secret (generate strong random string)
SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars

# Database
DATABASE_URL=sqlite:///./data/ai_farmer.db

# Application
APP_NAME=AI Farmer
DEBUG=false
LOG_LEVEL=INFO

# Model Paths
MODEL_PATH=./data/models
DATA_PATH=./data

# External Services
GOV_SCHEME_API_URL=https://api.example.gov/schemes
SOIL_TEST_API_URL=https://api.example.com/soil

# SMS / Notifications (Twilio / Fast2SMS / MSG91)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business API
WHATSAPP_API_KEY=your-whatsapp-api-key

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Email (SendGrid / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
