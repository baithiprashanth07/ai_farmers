# Copy these settings into Streamlit Community Cloud's app Secrets.
# Use a long, unique SECRET_KEY. Configure a managed PostgreSQL URL for
# persistent accounts and records; Streamlit Cloud local files are ephemeral.
SECRET_KEY = "replace-with-a-long-random-secret"
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional hosted AI provider. Remove these lines if AI advice is not needed.
AI_PROVIDER = "groq"
GROQ_API_KEY = "your-groq-api-key"
# AI_PROVIDER = "openai"
# OPENAI_API_KEY = "your-openai-api-key"
